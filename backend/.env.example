# ============================================
# CampusOps Backend — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env
#
# Generate strong secrets with: openssl rand -base64 64
# NEVER commit .env to git.
# ============================================

# ---------- Server ----------
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# ---------- Database (PostgreSQL) ----------
DATABASE_URL=postgresql://campusops:campusops_secret@localhost:5432/campusops_db?schema=public

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- JWT Authentication ----------
# IMPORTANT: Use long random secrets. Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=CHANGE_ME_run_openssl_rand_base64_64
JWT_REFRESH_SECRET=CHANGE_ME_run_openssl_rand_base64_64
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---------- Bcrypt ----------
BCRYPT_SALT_ROUNDS=12

# ---------- Rate Limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ---------- CORS ----------
CORS_ORIGIN=http://localhost:5173

# ---------- App Public URL (used in email links) ----------
APP_URL=http://localhost:5173

# ---------- Logging ----------
LOG_LEVEL=debug

# ---------- Telegram Bot ----------
# Create a bot at https://t.me/BotFather to get a token
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Set this to a random secret and configure it when registering the webhook with Telegram
# TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret

# ---------- Email / SMTP ----------
# Use Gmail App Password (not your account password): https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=CampusOps <noreply@campusops.ma>

# ---------- Email / IMAP (inbox reading) ----------
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=your-email@gmail.com
# IMAP_PASS=your-app-password
# IMAP_TLS=true
