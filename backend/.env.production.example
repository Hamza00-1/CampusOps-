# ============================================
# CampusOps Backend — Production Environment
# ============================================
# Copy to .env on your production server.
# All secrets MUST be changed from these placeholders.
#
# Quick deployment options:
#   Database : Supabase (supabase.com) or Neon (neon.tech) — free tier
#   API      : Railway (railway.app) or Render (render.com) — free tier
#   Frontend : Vercel (vercel.com) — free tier
# ============================================

# ---------- Server ----------
NODE_ENV=production
PORT=3000
API_PREFIX=/api

# ---------- Database ----------
# Supabase: Settings → Database → Connection string → URI mode
# Neon: Dashboard → Connection Details → Connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# ---------- Redis ----------
# Railway Redis addon → Variables → REDIS_URL
# Or Upstash (free tier): upstash.com
REDIS_URL=redis://default:PASSWORD@HOST:PORT

# ---------- JWT (REQUIRED — use strong random secrets) ----------
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_ACCESS_SECRET=REPLACE_WITH_64_BYTE_RANDOM_BASE64
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_RANDOM_BASE64
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---------- Bcrypt ----------
BCRYPT_SALT_ROUNDS=12

# ---------- Rate Limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ---------- CORS (your deployed frontend URL) ----------
CORS_ORIGIN=https://your-app.vercel.app

# ---------- App Public URL ----------
APP_URL=https://your-app.vercel.app

# ---------- Logging ----------
LOG_LEVEL=warn

# ---------- Telegram Bot ----------
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# After deployment, register the webhook:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://your-api.railway.app/api/telegram/webhook&secret_token=<SECRET>"
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET

# ---------- Email / SMTP ----------
# Gmail: enable 2FA → App Passwords → generate one for "Mail"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=CampusOps <noreply@campusops.ma>

# ---------- Email / IMAP (inbox reading, optional) ----------
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-email@gmail.com
IMAP_PASS=your-16-char-app-password
IMAP_TLS=true
